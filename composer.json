{
    "name": "nswdpc/silverstripe-authentication-boilerplate",
    "description": "Boilerplate default access rules for Silverstripe websites",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "keywords": [
      "silverstripe",
      "members",
      "password",
      "pwnage",
      "pwned",
      "mfa",
      "nswdpc",
      "2-factor",
      "2fa",
      "authentication",
      "security"
    ],
    "require": {
        "silverstripe/totp-authenticator": "^5",
        "nswdpc/silverstripe-pwnage-hinter": "^1",
        "silverstripe/securityreport" : "^3",
        "silverstripe/cms" : "^5.4"
    },
    "require-dev": {
        "cambis/silverstripe-rector": "^2",
        "phpunit/phpunit": "^9.5",
        "cambis/silverstan": "^2",
        "nswdpc/ci-files": "dev-v-4",
        "phpstan/phpstan": "^2",
        "rector/rector": "^2",
        "phpstan/phpstan-phpunit": "^2",
        "friendsofphp/php-cs-fixer": "^3"
    },
    "autoload": {
        "psr-4": {
            "NSWDPC\\Authentication\\Tests\\": [
                "tests/"
            ],
            "NSWDPC\\Authentication\\": [
                "src/"
            ]
        }
    },
    "authors": [
        {
            "name": "James Ellis",
            "role": "Developer"
        },
        {
            "name": "Mark Taylor",
            "role": "Developer"
        }
    ],
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "php-http/discovery": true,
            "silverstripe/vendor-plugin": true,
            "silverstripe/recipe-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
